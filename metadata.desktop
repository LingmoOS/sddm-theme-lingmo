; Lingmo login theme for SDDM
; Based on SilentSDDM - https://github.com/uiriansan/SilentSDDM

[SddmGreeterTheme]
Name=Lingmo
Type=sddm-theme
Description=Lingmo login theme for SDDM, based on SilentSDDM. Customizable, with animated backgrounds and more than 200 options.
License=GPL-3.0-or-later
Version=1.5.0
Theme-Id=lingmo
Theme-API=2.0
MainScript=Main.qml
Screenshot=docs/previews/default.png
TranslationsDirectory=translations
QtVersion=6

ConfigFile=configs/default.conf
